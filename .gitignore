node_modules/
dist/
.env
.env.*
!.env.example
*.local.log
.DS_Store

# Large local data files — voter roll stays out of git
UNION.txt
files.zip

# Real secrets — never commit
KEYS-AND-ACCESS.md
TEST-ACCOUNT-CREDENTIALS.local.md

# Simulated-demo artifacts: shared password for the fake canvasser accounts +
# the manifest of created ids (needed by simulate-canvass-history.mjs --wipe)
SIM-USERS.md
sim-manifest.json
DEMO-USERS.md
demo-manifest.json

# Project overview for Claude Code — local-only, not shared via git
CLAUDE.md

# Claude Code's local permission allowlist echoes raw command args (including
# any secrets passed on the command line) — keep it local, never push it.
.claude/settings.local.json

# Which agent is working on what right now (scripts/agent-setup.mjs). It lives
# in the main checkout because every worktree shares that one .git, so all of
# them can read it — and it describes this machine's session, never the repo.
.claude/in-flight.json

# Demo Studio working files (recordings/renders + mutable project state)
demo-studio/media/
demo-studio/project.json

# Local Netlify folder
.netlify

# Netlify Edge Functions bootstrap artifact (netlify dev)
deno.lock
.demo-scratch/

# Demo recorder local state: saved browser sessions (auth tokens) + the
# seeded-day plan (regenerated by seed-demo-day.mjs)
demo-studio/auto/state/
demo-studio/auto/demo-plan.json

# Downloaded research papers — local reference material only, never pushed
research/

# Local QA session page written by scratchpad/dev-login.mjs. It embeds a
# one-time Supabase magic link, and public/ ships to the live site, so this
# must never be committed or deployed.
public/dev-login.html

# Local-only sign-in bootstrap written by scripts/dev-login.mjs (holds a live
# session; never commit, never ship).
public/__dev-login.html
